{
  "name": "nuzlocke-tracker",
  "version": "1.0.0",
  "description": "Shared 4-player randomized Pokémon Nuzlocke tracker with live sync",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "build": "npm run build:html && npm run build:css",
    "build:html": "node scripts/build-html.js",
    "build:css": "tailwindcss -i src/app.css -o public/app.css --minify",
    "start": "node server.js",
    "dev": "node scripts/dev.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "chart.js": "^4.6.1",
    "express": "^4.21.2",
    "pg": "^8.23.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "tailwindcss": "^4.3.5"
  }
}
